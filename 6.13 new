import java.util.Random;
import java.util.Scanner;
import java.util.Arrays;

public class LabProgram1 {
   public static void main(String[] args) {
      Scanner scnr = new Scanner(System.in);

      int numberOfPairs;
      System.out.println("Please enter the number of elements to be paired.");
      numberOfPairs = scnr.nextInt();

      int[] range = new int[numberOfPairs * 2];
      int counter = 1;

      // Generate Pairs
      for (int arr = 0; arr < (numberOfPairs * 2); arr += 2) {
         range[arr] = counter;
         range[arr + 1] = counter;
         counter++;
      }
      System.out.println("Initial Pairs Before Shuffling: " + Arrays.toString(range));

      System.out.println("Please enter a seed number for testing purposes.");
      int seedVal = scnr.nextInt();

      Random randGen = new Random(seedVal);

      // Randomize with Mark-Zero Technique

      //Declaring an array
      int[] randomArr = new int[numberOfPairs * 2];
      
      // Looping through array
      for (int i = 0; i < randomArr.length; i++) {

         //picking a random variable
         int randomIndex;

         // Keep generating a random index until you find a non-zero value 
         randomIndex = randGen.nextInt(numberOfPairs * 2);
         //Using count to see how many times the random generator hops between 0 values
         int count = 0;
         while (range[randomIndex] == 0) {
            randomIndex = randGen.nextInt(numberOfPairs * 2);
            //remove count++, it is for checking only the value
            count++;
         }
         System.out.println("Count = "+count);

         // Assign the value and mark as 0
         randomArr[i] = range[randomIndex];
         range[randomIndex] = 0; // Mark processed
      }

      System.out.println("After Randomization: " + Arrays.toString(randomArr));

      // Print Randomized Pairs in Grid
      int[][] printPairs2 = new int[(numberOfPairs * 2) / 5][5];
      int y = 0;
      for (int i = 0; i < (numberOfPairs * 2) / 5; ++i) {
         for (int j = 0; j <= 4; ++j) {
            printPairs2[i][j] = randomArr[y];
            y++;
            System.out.printf("%4d", printPairs2[i][j]);
         }
         System.out.println();
      }
   }
}
