
public class ProgramSummary{
    public static void main(String[] args){
        final int[][] timesTable = new int[12][];

        for (int i = 0; i < 12; i++) {
            int[] row = new int[12];
            for (int j = 0; j < 12; j++) {
                row[j] = (i + 1) * (j + 1);
            }
            timesTable[i] = row;
        }

        for (int i = 0; i < 12; i++) {
            for (int j = 0; j < 12; j++) {
                System.out.printf("%4d", timesTable[i][j]);
            }
            System.out.println();
        }

        System.out.println();

        for (int i = 0; i < 12; i++) {
            for (int j = 0; j <= i; j++) {
                System.out.printf("%4d", timesTable[i][j]);
            }
            System.out.println();
        }

        System.out.println();

         int rowCounter = 11;
        for (int i = 0; i < 12; i++) {
            for (int j = 0; j <= rowCounter; j++) {
               System.out.printf("%4d", timesTable[i][j]);
            }
            rowCounter = rowCounter - 1;
            System.out.println();
        }

        System.out.println();

         // 4 
//         rowCounter = 1;
//        for (int i = 0; i < 12; i++) {
//            for (int j = rowCounter; j >= 0; j--) {
//            }
//            rowCounter = rowCounter + 1;
//            System.out.println();
//       }
         rowCounter = 11;
         for (int i = 0; i <= 12; i++) {
            for (int j = rowCounter; j <= 11; j--) {
                System.out.printf("%4d", timesTable[i][j]);
            }
            rowCounter = rowCounter - 1;
            System.out.println();
        }
        
        //System.out.println();

         rowCounter = 11;
         for (int i = 0; i < 12; i++) {
            for (int j = 11; j >= rowCounter; j--) {
                System.out.printf("%4d", timesTable[i][j]);
            }
            rowCounter = rowCounter - 1;
            System.out.println();
        }
        
        System.out.println();
    }
}
