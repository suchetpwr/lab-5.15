public class ProgramSummary{
    public static void main(String[] args){
        final int[][] timesTable = new int[12][];

        for (int i = 0; i < 12; i++) {
            int[] row = new int[12];
            for (int j = 0; j < 12; j++) {
                row[j] = (i + 1) * (j + 1);
            }
            timesTable[i] = row;
        }

       System.out.println("PRinting the first half of table");
        for (int i = 0; i < 12; i++) {
            for (int j = 0; j < 12; j++) {
                System.out.printf("%4d", timesTable[i][j]);
            }
            System.out.println();
        }

        System.out.println();

        System.out.println("PRinting the second block");
        for (int i = 0; i < 12; i++) {
            for (int j = 0; j <= i; j++) {
                System.out.printf("%4d", timesTable[i][j]);
            }
            System.out.println();
        }

        System.out.println();

        System.out.println("PRinting third block");
         int rowCounter = 11;
        for (int i = 0; i < 12; i++) {
            for (int j = 0; j <= rowCounter; j++) {
               System.out.printf("%4d", timesTable[i][j]);
            }
            rowCounter = rowCounter - 1;
            System.out.println();
        }

        System.out.println();

         // 4 
//         rowCounter = 1;
//        for (int i = 0; i < 12; i++) {
//            for (int j = rowCounter; j >= 0; j--) {
//            }
//            rowCounter = rowCounter + 1;
//            System.out.println();
//       }

        System.out.println("PRinting fourth block");
         rowCounter = 11;
         for (int i = 0; i <= 11; i++) {
            if(rowCounter < 0){
                break;
             }
            for (int j = rowCounter; j <= 11; j--) {
                if(j == 0){
                    System.out.printf("%4d", timesTable[i][j]);
                    break;
                }
                System.out.printf("%4d", timesTable[i][j]);
            }
            rowCounter = rowCounter - 1;
            System.out.println();
        }
        
        //System.out.println();
        System.out.println("PRinting fifth block");
         rowCounter = 11;
         for (int i = 0; i < 12; i++) {
            //System.out.print(" I = " + i);
            for (int j = 11; j >= rowCounter; j--) {
                //System.out.print(" J = " + j);
                System.out.printf("%4d", timesTable[i][j]);
            }
            rowCounter = rowCounter - 1;
            System.out.println();
        }
        
        System.out.println();
    }
}
