import java.util.Scanner;

public class DateParser {
   public static int getMonthAsInt(String monthString) {
      int monthInt;
      
      // Java switch/case statement                                                                
      switch (monthString) {
         case "January": 
            monthInt = 1; 
            break;
         case "February": 
            monthInt = 2; 
            break;
         case "March": 
            monthInt = 3; 
            break;
         case "April": 
            monthInt = 4; 
            break;
         case "May": 
            monthInt = 5; 
            break;
         case "June": 
            monthInt = 6; 
            break;
         case "July": 
            monthInt = 7; 
            break;
         case "August": 
            monthInt = 8; 
            break;
         case "September": 
            monthInt = 9; 
            break;
         case "October": 
            monthInt = 10; 
            break;
         case "November": 
            monthInt = 11; 
            break;
         case "December": 
            monthInt = 12; 
            break;
         default: 
            monthInt = 0;
      }
      
      return monthInt;
   }

   public static void main(String[] args) {
      Scanner scnr = new Scanner(System.in);

      // TODO: Read dates from input, parse the dates to find the ones
      //       in the correct format, and output in m-d-yyyy format
     
     String input = scnr.nextLine();
     
     while (! (input.equals("-1")))  {
        boolean isMonth = false; 
        int spaceIndex = input.indexOf(" ");
        System.out.println(spaceIndex);
        int stringLength = input.length();
        //System.out.println(stringLength);
        int space = input.lastIndexOf(" ");
        System.out.println(space);
        int commaIndex = input.indexOf(",");
        System.out.println(commaIndex);
        
 
        if ((spaceIndex != -1) || (commaIndex != -1) || (space != -1)) {
            char checkMonth = input.charAt(0);
           if (Character.isLetter(checkMonth)) {
              String year = input.substring(space + 1, stringLength);
              //System.out.println(year);
              String day = input.substring(spaceIndex + 1, commaIndex);
              //System.out.println(day);
              String month = input.substring(0, spaceIndex);
              //System.out.println(month);
              int monthNum = getMonthAsInt(month);
              //System.out.println(monthNum);
              if (monthNum != 0) {
                 isMonth = true;
                 System.out.println(monthNum + "-" + day + "-" + year); 
            }
            
             
        }
      }
      input = scnr.nextLine();  
     }
     
   }
}
